# MongoDB Database Connection
MONGO_URL=mongodb://localhost:27017
DB_NAME=nest_crm_production

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://yourdomain.com

# JWT Secret (Generate a strong 64-character random string)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string

# Initial Superadmin Credentials
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ReplaceWithStrongPassword123!

# Runtime Environment (development | production)
ENVIRONMENT=development
